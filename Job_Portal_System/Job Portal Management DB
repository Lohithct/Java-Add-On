///////////////
-- JOBS TABLE
//////////////

CREATE TABLE jobs (
    id NUMBER PRIMARY KEY,
    job_name VARCHAR2(50),
    requirement VARCHAR2(100),
    qualification VARCHAR2(50)
);


CREATE SEQUENCE job_seq START WITH 1 INCREMENT BY 1;


