/////////////////////
-- APPLICANTS TABLE
/////////////////////

CREATE TABLE applicants (
    id NUMBER PRIMARY KEY,
    applicant_name VARCHAR2(50),
    age NUMBER,
    phone NUMBER(10),
    address VARCHAR2(80),
    mail_id VARCHAR2(50),
    experience VARCHAR2(30),
    job_applied NUMBER
);


CREATE SEQUENCE app_seq START WITH 1 INCREMENT BY 1;
